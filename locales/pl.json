            "#responses": {
                "not_found": "Nie znaleziono użytkownika pasującego do `{query}`.",
                "found_one": "Znaleziono użytkownika pasującego do `{query}`.",
                "found_multiple_limited": "Znaleziono `{count}` użytkowników pasujących do `{query}`.\nPokazuję tylko pierwsze {limit}.",
                "found_multiple": "Znaleziono `{count}` użytkowników pasujących do `{query}`."
            }
        }
